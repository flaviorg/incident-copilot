#!/bin/sh
# incident-copilot pre-commit (spec 6.6 and AC-41): typecheck, unit tests and secret scan.
# Install it only once the folder has its own Git repository: npm run setup:hooks (sets the repository's core.hooksPath).
# End-to-end tests run in CI and in npm run verify, so the hook stays fast.
set -e
cd "$(dirname "$0")/.."
npm run --silent typecheck
npm run --silent test:unit
npm run --silent check:secrets
