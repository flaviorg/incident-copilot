# Copie para .env e ajuste. O .env fica fora do Git (.gitignore). Variável vazia conta como ausente e usa o padrão.
# npm test nunca lê este arquivo; npm start, npm run mcp, npm run cli e npm run test:live leem o .env se existir.

# Provedor de LLM: fake ou openrouter. Vazio: fake, ou openrouter se OPENROUTER_API_KEY estiver definida.
# LLM_PROVIDER=fake força o fake mesmo com chave. npm run demo sempre usa o fake, salvo com --live.
LLM_PROVIDER=

# Chave do OpenRouter. Obrigatória com o provedor openrouter. Nunca é ecoada em nenhuma saída.
OPENROUTER_API_KEY=

# Modelo principal no OpenRouter. Obrigatório com openrouter; precisa suportar saída estruturada.
OPENROUTER_MODEL=

# Modelo de reserva, tentado depois de 2 falhas do principal. Opcional.
OPENROUTER_MODEL_FALLBACK=

# Endpoint compatível com a API da OpenAI.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Timeout de cada chamada ao LLM, em milissegundos.
LLM_TIMEOUT_MS=30000

# Timeout de cada execução do grafo, em milissegundos (a API responde 504 ao passar).
RUN_TIMEOUT_MS=180000

# Arquivo SQLite. :memory: também é aceito (os dados somem ao encerrar).
DB_PATH=./data/incident-copilot.db

# Endereço e porta da API. Mantenha 127.0.0.1: a API não tem CORS nem rate limit HTTP.
HOST=127.0.0.1
PORT=3000

# Token de aprovação, exigido no header X-Approval-Token de POST /approvals/:id/decision.
# Vazio: decisões respondem 503. Quando definido, mínimo de 16 caracteres. Gere um valor aleatório, por exemplo:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
APPROVAL_TOKEN=

# Validade de uma aprovação pendente, em minutos.
APPROVAL_TTL_MIN=30

# Execuções de ação por minuto, no total.
ACTION_RATE_LIMIT_PER_MIN=5

# Janela em que a mesma ação no mesmo alvo roda no máximo 1 vez, em minutos.
ACTION_REPEAT_WINDOW_MIN=10

# Falhas consecutivas (execução ou canário) antes de o circuit breaker abrir.
CIRCUIT_FAILURE_THRESHOLD=3

# Tempo com o breaker aberto antes da meia-abertura, em segundos.
CIRCUIT_COOLDOWN_SEC=300

# Relógio: system (API e MCP) ou simulated (demo e testes).
CLOCK=system

# Nível de log em stderr: debug, info, warn ou error.
LOG_LEVEL=info
