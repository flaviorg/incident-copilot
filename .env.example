# Copy to .env and adjust. .env stays out of Git (.gitignore). An empty variable counts as unset and uses the default.
# npm test never reads this file; npm start, npm run mcp, npm run cli and npm run test:live read .env when it exists.

# LLM provider: fake or openrouter. Empty: fake, or openrouter when OPENROUTER_API_KEY is set.
# LLM_PROVIDER=fake forces the fake even with a key. npm run demo always uses the fake, except with --live.
LLM_PROVIDER=

# OpenRouter key. Required with the openrouter provider. Never echoed in any output.
OPENROUTER_API_KEY=

# Primary OpenRouter model. Required with openrouter; it must support structured output.
OPENROUTER_MODEL=

# Fallback model, tried after 2 failures of the primary. Optional.
OPENROUTER_MODEL_FALLBACK=

# Endpoint compatible with the OpenAI API.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Timeout of each LLM call, in milliseconds.
LLM_TIMEOUT_MS=30000

# Timeout of each graph run, in milliseconds (the API answers 504 when it is exceeded).
RUN_TIMEOUT_MS=180000

# SQLite file. :memory: is also accepted (the data is lost on exit).
DB_PATH=./data/incident-copilot.db

# API address and port. Keep 127.0.0.1 when you can: the API has no CORS and no users or roles.
# Requests whose Host header is not this address (or localhost / [::1]) on PORT, or one of ALLOWED_HOSTS, get 421.
HOST=127.0.0.1
PORT=3000

# API token, required in "Authorization: Bearer <token>" on every route except GET /health. Optional on loopback;
# REQUIRED when HOST is not a loopback address (npm start refuses to start otherwise). At least 16 characters, and
# different from APPROVAL_TOKEN. Generate it like the approval token below.
API_TOKEN=

# Extra host names accepted in the Host header, comma separated (for example myhost:3000). Optional.
ALLOWED_HOSTS=

# Incident runs (POST /incidents) allowed at the same time; more get 429.
MAX_CONCURRENT_RUNS=2

# Approval token, required in the X-Approval-Token header of POST /approvals/:id/decision.
# Empty: decisions answer 503. When set, at least 16 characters. Generate a random value, for example:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
APPROVAL_TOKEN=

# Validity of a pending approval, in minutes.
APPROVAL_TTL_MIN=30

# Action executions per minute, in total.
ACTION_RATE_LIMIT_PER_MIN=5

# Window in which the same action on the same target runs at most once, in minutes.
ACTION_REPEAT_WINDOW_MIN=10

# Consecutive failures (execution or canary) before the circuit breaker opens.
CIRCUIT_FAILURE_THRESHOLD=3

# Time with the breaker open before half-open, in seconds.
CIRCUIT_COOLDOWN_SEC=300

# Clock: system (API and MCP) or simulated (demo and tests).
CLOCK=system

# Log level on stderr: debug, info, warn or error.
LOG_LEVEL=info
